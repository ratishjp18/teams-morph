{
  "name": "teams-morph",
  "version": "1.0.0",
  "description": "Microsoft Teams Desktop Theme Customizer - Personalize your Teams appearance",
  "main": "dist/main/index.js",
  "author": "Teams Morph",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build:dev && npm-run-all --parallel watch:main dev:renderer start:electron",
    "dev:simple": "npm run build:dev && npm run start",
    "build:dev": "npm run build:main:dev && npm run build:preload:dev && npm run build:renderer:dev",
    "build:main:dev": "node ./node_modules/webpack-cli/bin/cli.js --config webpack.main.config.js --mode development",
    "build:preload:dev": "node ./node_modules/webpack-cli/bin/cli.js --config webpack.preload.config.js --mode development",
    "build:renderer:dev": "node ./node_modules/webpack-cli/bin/cli.js --config webpack.renderer.config.js --mode development",
    "watch:main": "node ./node_modules/webpack-cli/bin/cli.js --config webpack.main.config.js --mode development --watch",
    "dev:renderer": "node ./node_modules/webpack-cli/bin/cli.js serve --config webpack.renderer.config.js --mode development",
    "start:electron": "wait-on http://localhost:3000 && npm run start",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "node ./node_modules/webpack-cli/bin/cli.js --config webpack.main.config.js --mode production",
    "build:preload": "node ./node_modules/webpack-cli/bin/cli.js --config webpack.preload.config.js --mode production",
    "build:renderer": "node ./node_modules/webpack-cli/bin/cli.js --config webpack.renderer.config.js --mode production",
    "start": "node ./node_modules/electron/cli.js .",
    "package": "npm run build && node ./node_modules/electron-builder/cli.js --win",
    "lint": "node ./node_modules/eslint/bin/eslint.js src --ext .ts,.tsx",
    "type-check": "node ./node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "wait-on": "^7.2.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.8.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.0.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "html-webpack-plugin": "^5.5.0",
    "mini-css-extract-plugin": "^2.7.6",
    "postcss": "^8.4.32",
    "postcss-loader": "^7.3.3",
    "style-loader": "^3.3.3",
    "tailwindcss": "^3.3.6",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "build": {
    "appId": "com.teamsmorph.app",
    "productName": "Teams Morph",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "allowScripts": {
    "electron@28.3.3": true
  }
}
